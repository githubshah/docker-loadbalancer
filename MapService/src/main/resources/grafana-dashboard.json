{
  "annotations": { "list": [ { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard" } ] },
  "editable": true, "fiscalYearStartMonth": 0, "graphTooltip": 0, "links": [], "liveNow": false, "panels": [
  {
    "title": "REST API Throughput (Req/Sec)",
    "type": "timeseries",
    "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
    "targets": [
      {
        "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (uri, method)",
        "legendFormat": "{{method}} {{uri}}",
        "refId": "A"
      }
    ],
    "fieldConfig": {
      "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "gradientMode": "area" } }
    }
  },
  {
    "title": "Average Response Time (ms)",
    "type": "timeseries",
    "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
    "targets": [
      {
        "expr": "sum(rate(http_server_requests_seconds_sum[5m])) by (uri) / sum(rate(http_server_requests_seconds_count[5m])) by (uri) * 1000",
        "legendFormat": "{{uri}}",
        "refId": "A"
      }
    ],
    "fieldConfig": {
      "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter" } }
    }
  },
  {
    "title": "HTTP Errors by Status (5xx)",
    "type": "timeseries",
    "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
    "targets": [
      {
        "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) by (uri, status)",
        "legendFormat": "Error {{status}} on {{uri}}",
        "refId": "A"
      }
    ],
    "fieldConfig": {
      "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "unit": "ops" }
    }
  }
],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["JVM", "REST"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "JVM REST API Performance Monitor"
}